{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    // Source maps let monocart-coverage map V8 coverage on dist/*.js back to src/*.ts,
    // so coverage-driven scenario discovery reads the TypeScript source, not compiled output.
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "client"]
}
