{
  "no-unnamed-features": "error",
  "no-unnamed-scenarios": "error",
  "no-dupe-feature-names": "error",
  "no-dupe-scenario-names": "error",
  "keywords-in-logical-order": "error",
  "use-and": "error",
  "no-unused-variables": "error",
  "no-scenario-outlines-without-examples": "error",
  "no-examples-in-scenarios": "error",
  "no-files-without-scenarios": "error",
  "no-empty-file": "error",
  "no-empty-background": "error",
  "indentation": "error",
  "table-align": "error",
  "new-line-at-eof": ["error", "yes"],
  "no-trailing-spaces": "error",
  "no-multiple-empty-lines": "error",
  "no-duplicate-tags": "error",
  "no-partially-commented-tag-lines": "error",
  "no-superfluous-tags": "error",
  "one-space-between-tags": "error",
  "allowed-tags": ["error", { "tags": ["@primary-region-only", "@secondary-region-only", "@disaster-recovery-only", "@no-parallel"] }],
  "then-step-ordering": "error",
  "well-known-io-names": ["error", { "names": ["subscriber-insert", "subscriber-delete", "topic-flags-upsert", "patch-response", "post-response", "delivery-call", "delivery-log"] }],
  "unasserted-example-column": "warn",
  "example-column-whole-step": "error"
}
